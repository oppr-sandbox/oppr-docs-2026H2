# Frontend (Vite) — read by the browser at build time.
# Convex injects VITE_CONVEX_URL automatically during `convex dev` / `convex deploy`.
# Both are required on Vercel.

# Your Convex deployment URL, e.g. https://your-deployment.convex.cloud
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex HTTP-actions URL (the .convex.site host) — used for Ask IDA streaming.
# Same deployment, .site instead of .cloud, e.g. https://your-deployment.convex.site
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# NOTE: Gemini runs server-side via Convex actions, NOT in the browser.
# Set the API key on the Convex backend, not here:
#   npx convex env set GEMINI_API_KEY <key>            (dev)
#   npx convex env set --prod GEMINI_API_KEY <key>     (production)
